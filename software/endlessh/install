#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
set -euo pipefail

PORT=${ENDLESSH_PORT:-2222}
CONFIG=/etc/endlessh/config

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y endlessh
install -d -m 0755 /etc/endlessh

if [[ ! -e $CONFIG ]]; then
	cat > "$CONFIG" <<EOF
Port $PORT
Delay 10000
MaxLineLength 32
MaxClients 4096
LogLevel 1
BindFamily 0
EOF
	chmod 0644 "$CONFIG"
fi

systemctl enable --now endlessh.service
systemctl is-active --quiet endlessh.service
